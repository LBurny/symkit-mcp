# 環境變數範例
# 複製此檔案為 .env 並填入實際值

# 應用程式設定
APP_NAME=workspace251215
APP_ENV=development
APP_DEBUG=true

# 資料庫設定
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=user
DB_PASSWORD=

# API 金鑰（請勿提交真實金鑰）
API_KEY=
SECRET_KEY=

# 外部服務
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# SymKit（MCP 符號推導伺服器）
# 會話與公式庫根目錄（預設為使用者資料目錄；多專案隔離時指向專案內目錄）
# SYMKIT_DATA_DIR=
